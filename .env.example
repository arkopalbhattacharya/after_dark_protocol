# AFTER DARK PROTOCOL // ENVIRONMENT SCHEMA & SECRETS REFERENCE

# Local / CI Site URL (Surge production or localhost)
VITE_SITE_URL=https://after-dark-protocol.surge.sh

# Supabase API Credentials (Dev or Prod)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Poolside / AI Service Key
VITE_POOLSIDE_API_KEY=your-api-key-here

# GitHub Actions Secrets (Add these to Repo -> Settings -> Secrets and variables -> Actions):
# - SURGE_TOKEN                 (Run `npx surge token` to retrieve)
# - SURGE_LOGIN                 (Your Surge account email)
# - VITE_SUPABASE_URL_DEV       (Dev Supabase project URL)
# - VITE_SUPABASE_ANON_KEY_DEV  (Dev Supabase project anon public key)
